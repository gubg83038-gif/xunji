/* ---------- 上下文切换 ---------- */
/* 横向滚动三要素：容器 white-space:nowrap + 子项 inline-block + 子项之间不留白
   （用 margin 而非换行产生的空格，否则会出现额外间隙） */
.ctx {
  white-space: nowrap;
  padding: 20rpx 0 10rpx 24rpx;
}

.ctx__item {
  display: inline-block;
  width: 300rpx;
  padding: 20rpx 22rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid transparent;
  box-shadow: 0 6rpx 18rpx rgba(16, 24, 40, 0.05);
  vertical-align: top;
  box-sizing: border-box;
  /* 卡片内部恢复换行，避免上面 nowrap 影响文字排版 */
  white-space: normal;
}

.ctx__item.is-on {
  border-color: #2e6be6;
  background: #f5f9ff;
}

.ctx__icon {
  font-size: 34rpx;
  line-height: 1.2;
}

.ctx__label {
  font-size: 27rpx;
  font-weight: 600;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ctx__meta {
  font-size: 20rpx;
  color: #98a2b3;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 统计条 ---------- */
.sum {
  margin: 12rpx 24rpx 0;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, #f0f6ff, #eaf1ff);
  border-radius: 22rpx;
}

.sum__main {
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
  color: #1b47a8;
}

.sum__num {
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 6rpx;
}

.sum__unit { margin-right: 10rpx; }

.sum__sep { margin: 0 10rpx; color: #93b4f5; }

.sum__passed { font-weight: 600; }

.sum__sub {
  font-size: 21rpx;
  color: #4763a8;
  margin-top: 8rpx;
}

.sum__link {
  color: #2e6be6;
  text-decoration: underline;
  margin-left: 10rpx;
}

/* ---------- 工具栏 ---------- */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 0;
}

.sorts {
  display: flex;
  gap: 12rpx;
}

.sort {
  font-size: 23rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #667085;
  border: 2rpx solid #eaecf0;
}

.sort.is-on {
  background: #2e6be6;
  color: #fff;
  border-color: #2e6be6;
  font-weight: 600;
}

.rerun {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #eaecf0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #2e6be6;
}

/* ---------- 过滤 ---------- */
/* 同理：容器 nowrap + 子项 inline-block 才能横向滚动 */
.filters {
  white-space: nowrap;
  padding: 16rpx 0 0 24rpx;
}

.filter {
  display: inline-block;
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  color: #667085;
  vertical-align: middle;
}

.filter.is-on {
  background: #eaf1ff;
  color: #1b47a8;
  font-weight: 600;
}

/* picker 默认是块级元素，会让后面的筛选按钮换行，这里改成行内 */
.filter-picker {
  display: inline-block;
  vertical-align: middle;
  margin-right: 12rpx;
}

/* ---------- 搜索 ---------- */
.search {
  position: relative;
  margin: 18rpx 24rpx 0;
}

.search__input {
  background: #fff;
  border-radius: 999rpx;
  padding: 18rpx 70rpx 18rpx 30rpx;
  font-size: 25rpx;
  box-shadow: 0 4rpx 14rpx rgba(16, 24, 40, 0.04);
}

.search__clear {
  position: absolute;
  right: 26rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #98a2b3;
  font-size: 32rpx;
}

/* ---------- 列表 ---------- */
.list {
  padding: 22rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hint {
  padding: 30rpx 40rpx 60rpx;
  font-size: 20rpx;
  color: #b0b7c3;
  text-align: center;
  line-height: 1.6;
}
