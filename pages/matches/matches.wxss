/* ---------- 上下文切换 ---------- */
/* 横向滚动三要素：容器 white-space:nowrap + 子项 inline-block + 子项之间不留白
   （用 margin 而非换行产生的空格，否则会出现额外间隙） */
.ctx {
  white-space: nowrap;
  padding: 20rpx 0 10rpx 24rpx;
}

.ctx__item {
  display: inline-block;
  width: 300rpx;
  padding: 20rpx 22rpx;
  margin-right: 16rpx;
  border-radius: var(--r-md);
  background: #fff;
  border: 2rpx solid transparent;
  box-shadow: 0 6rpx 18rpx rgba(16, 24, 40, 0.05);
  vertical-align: top;
  box-sizing: border-box;
  /* 卡片内部恢复换行，避免上面 nowrap 影响文字排版 */
  white-space: normal;
}

.ctx__item.is-on {
  border-color: var(--c-primary);
  background: #f5f9ff;
}

.ctx__icon {
  font-size: 34rpx;
  line-height: 1.2;
}

.ctx__label {
  font-size: 27rpx;
  font-weight: 600;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ctx__meta {
  font-size: 20rpx;
  color: var(--c-ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 统计条（对照设计稿：一句醒目的结论 + 统计细节）---------- */
.sum {
  margin: 12rpx 24rpx 0;
  padding: 26rpx 26rpx;
  background: linear-gradient(135deg, #f0f6ff, #eef0ff 60%, #f3edff);
  border-radius: var(--r-lg);
  box-shadow: 0 8rpx 22rpx rgba(79, 142, 247, 0.10);
}

.sum__headline {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-ink);
}

.sum__headline .sum__num {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--c-primary);
  margin: 0 6rpx;
}

.sum__main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--c-primary-deep);
}

.sum__num {
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 6rpx;
}

.sum__unit { margin-right: 10rpx; }

.sum__sep { margin: 0 10rpx; color: #93b4f5; }

.sum__passed { font-weight: 600; }

.sum__avg { font-weight: 600; }

.sum__sub {
  font-size: 21rpx;
  color: #4763a8;
  margin-top: 8rpx;
}

.sum__link {
  color: var(--c-primary);
  text-decoration: underline;
  margin-left: 10rpx;
}

/* ---------- 已排除提示条 ---------- */
/* 排除后候选立刻从列表消失，这条提示负责回答「它去哪了、怎么撤销」 */
.excluded-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: var(--r-md);
  background: #fff7e6;
  border: 2rpx solid #fde3b0;
  font-size: 22rpx;
  color: #92400e;
}

.excluded-bar__icon {
  margin-right: 12rpx;
  flex: none;
}

.excluded-bar__link {
  flex: none;
  color: #b45309;
  font-weight: 600;
  text-decoration: underline;
  margin-left: 12rpx;
}

.excluded-tip {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 22rpx;
  border-radius: var(--r-md);
  background: #f9fafb;
  font-size: 21rpx;
  color: var(--c-ink-3);
  line-height: 1.6;
}

/* ---------- 工具栏 ---------- */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 0;
}

.sorts {
  display: flex;
  gap: 12rpx;
}

.sort {
  font-size: 23rpx;
  padding: 10rpx 22rpx;
  border-radius: var(--r-pill);
  background: #fff;
  color: #667085;
  border: 2rpx solid var(--c-line);
}

.sort.is-on {
  background: var(--c-primary);
  color: #fff;
  border-color: var(--c-primary);
  font-weight: 600;
}

.rerun {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid var(--c-line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--c-primary);
}

/* ---------- 过滤 ---------- */
/* 同理：容器 nowrap + 子项 inline-block 才能横向滚动 */
.filters {
  white-space: nowrap;
  padding: 16rpx 0 0 24rpx;
}

.filter {
  display: inline-block;
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  margin-right: 12rpx;
  border-radius: var(--r-pill);
  background: #f2f4f7;
  color: #667085;
  vertical-align: middle;
}

.filter.is-on {
  background: var(--c-primary-weak);
  color: var(--c-primary-deep);
  font-weight: 600;
}

/* picker 默认是块级元素，会让后面的筛选按钮换行，这里改成行内 */
.filter-picker {
  display: inline-block;
  vertical-align: middle;
  margin-right: 12rpx;
}

/* ---------- 搜索 ---------- */
.search {
  position: relative;
  margin: 18rpx 24rpx 0;
}

.search__input {
  background: #fff;
  border-radius: var(--r-pill);
  padding: 18rpx 70rpx 18rpx 30rpx;
  font-size: 25rpx;
  box-shadow: 0 4rpx 14rpx rgba(16, 24, 40, 0.04);
}

.search__clear {
  position: absolute;
  right: 26rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--c-ink-3);
  font-size: 32rpx;
}

/* ---------- 列表 ---------- */
.list {
  padding: 22rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hint {
  padding: 30rpx 40rpx 60rpx;
  font-size: 20rpx;
  color: #b0b7c3;
  text-align: center;
  line-height: 1.6;
}

/* ---------- 吉祥物探头（对照设计稿：列表底部的小鼋）---------- */
.peek {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 8rpx;
}

.peek .mascot--peek {
  width: 230rpx;
  height: 230rpx;
}
