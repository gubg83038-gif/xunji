.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 8rpx 24rpx;
}

.head__op {
  font-size: 24rpx;
  color: var(--c-primary);
  padding-top: 16rpx;
}

.ntf {
  position: relative;
  margin-bottom: 20rpx;
}

.ntf.is-unread {
  border-left: 8rpx solid var(--c-primary);
}

.ntf__dot {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--c-danger);
}

.ntf__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-right: 20rpx;
}

.ntf__title {
  font-size: 29rpx;
  font-weight: 600;
}

.ntf__time {
  font-size: 20rpx;
  color: var(--c-ink-3);
}

.ntf__body {
  font-size: 24rpx;
  color: #667085;
  line-height: 1.6;
  margin-top: 10rpx;
}

.ntf__pair {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f9fafb;
  border-radius: var(--r-sm);
  padding: 18rpx 20rpx;
  margin-top: 16rpx;
}

.ntf__label {
  font-size: 20rpx;
  color: var(--c-ink-3);
}

.ntf__name {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.ntf__loc {
  font-size: 21rpx;
  color: var(--c-ink-3);
  margin-top: 2rpx;
}

.ntf__score {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c-primary);
  flex: none;
  margin-left: 18rpx;
}

.ntf__foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}
