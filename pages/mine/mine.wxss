/* ---------- 用户卡（对照 UI 设计稿：大圆形头像 + 药丸用户名）---------- */
.profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 8rpx 8rpx;
}

/**
 * 头像位用圆形（设计稿是圆形头像）。
 * 里面放 emoji 而不是昵称文本——昵称是两三个字，塞进圆形会撑破布局。
 * 以后接微信真实头像，把这里换成 <image> 即可。
 */
.profile__avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f8ef7, #7b5cf0);
  color: #fff;
  font-size: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 5rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 10rpx 24rpx rgba(79, 142, 247, 0.3);
}

/* 药丸用户名（设计稿里昵称装在一个蓝紫胶囊里） */
.profile__pill {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  padding: 0 26rpx;
  border-radius: var(--r-pill);
  background: linear-gradient(100deg, #7b7cf0 0%, #4f8ef7 100%);
  box-shadow: 0 10rpx 24rpx rgba(79, 142, 247, 0.28);
}

.profile__pill-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile__pill-arrow {
  flex: none;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-left: 12rpx;
}

/* 资料条 */
.profile-meta {
  margin-top: 12rpx;
}

.profile-meta__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-meta__college {
  font-size: 23rpx;
  color: var(--c-ink-2);
}

.profile-meta__credit {
  font-size: 21rpx;
  color: var(--c-primary-deep);
  background: var(--c-primary-weak);
  border-radius: var(--r-pill);
  padding: 4rpx 16rpx;
}

.profile__stats {
  font-size: 21rpx;
  color: #667085;
  margin-top: 12rpx;
}

.profile__dot { margin: 0 10rpx; }

.profile__bell {
  position: relative;
  font-size: 38rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: 0 6rpx 16rpx rgba(16, 24, 40, 0.08);
}

.profile__badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: var(--r-pill);
  background: var(--c-danger);
  color: #fff;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
}

/* ---------- tabs ---------- */
.tabs {
  display: flex;
  gap: 12rpx;
  margin: 26rpx 0 22rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  padding: 18rpx 0;
  border-radius: var(--r-pill);
  background: #fff;
  color: #667085;
  border: 2rpx solid var(--c-line);
}

.tab.is-on {
  background: var(--c-primary);
  border-color: var(--c-primary);
  color: #fff;
  font-weight: 600;
}

/* ---------- 列表项 ---------- */
.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
}

.item__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r-md);
  background: var(--c-primary-weak);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex: none;
}

.item__title {
  font-size: 29rpx;
  font-weight: 600;
}

.item__meta {
  font-size: 22rpx;
  color: #667085;
  margin-top: 6rpx;
}

.item__meta--weak { color: var(--c-ink-3); }

.item__right {
  flex: none;
  text-align: right;
}

.item__count {
  font-size: 20rpx;
  color: var(--c-ink-3);
  margin-top: 10rpx;
}

.item__op {
  font-size: 22rpx;
  color: var(--c-primary);
  margin-top: 10rpx;
}

/* ---------- 工具 ---------- */
.tools__item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}

.tools__icon { font-size: 40rpx; }

.tools__title {
  font-size: 28rpx;
  font-weight: 600;
}

.tools__desc {
  font-size: 22rpx;
  color: var(--c-ink-3);
  margin-top: 4rpx;
}

.tools__arrow {
  font-size: 36rpx;
  color: #d0d5dd;
}

.footnote {
  margin: 36rpx 12rpx 0;
  font-size: 20rpx;
  color: #b0b7c3;
  line-height: 1.6;
  text-align: center;
}

/* ---------- 工具行的 3D 图标（对照设计稿）---------- */
.tools__icon-img {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
}
