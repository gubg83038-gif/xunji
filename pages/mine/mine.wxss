/* ---------- 用户卡 ---------- */
.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #ffffff, #f4f8ff);
}

.profile__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #3d7bf0, #2e6be6);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.profile__name {
  font-size: 34rpx;
  font-weight: 700;
}

.profile__switch {
  font-size: 20rpx;
  color: #2e6be6;
  border: 2rpx solid #bcd2fb;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-left: 14rpx;
  font-weight: 400;
}

.profile__meta {
  font-size: 23rpx;
  color: #98a2b3;
  margin-top: 8rpx;
}

.profile__stats {
  font-size: 21rpx;
  color: #667085;
  margin-top: 10rpx;
}

.profile__dot { margin: 0 10rpx; }

.profile__bell {
  position: relative;
  font-size: 38rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: 0 6rpx 16rpx rgba(16, 24, 40, 0.08);
}

.profile__badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #f04438;
  color: #fff;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
}

/* ---------- tabs ---------- */
.tabs {
  display: flex;
  gap: 12rpx;
  margin: 26rpx 0 22rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #fff;
  color: #667085;
  border: 2rpx solid #eaecf0;
}

.tab.is-on {
  background: #2e6be6;
  border-color: #2e6be6;
  color: #fff;
  font-weight: 600;
}

/* ---------- 列表项 ---------- */
.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
}

.item__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #eaf1ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex: none;
}

.item__title {
  font-size: 29rpx;
  font-weight: 600;
}

.item__meta {
  font-size: 22rpx;
  color: #667085;
  margin-top: 6rpx;
}

.item__meta--weak { color: #98a2b3; }

.item__right {
  flex: none;
  text-align: right;
}

.item__count {
  font-size: 20rpx;
  color: #98a2b3;
  margin-top: 10rpx;
}

.item__op {
  font-size: 22rpx;
  color: #2e6be6;
  margin-top: 10rpx;
}

/* ---------- 工具 ---------- */
.tools__item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}

.tools__icon { font-size: 40rpx; }

.tools__title {
  font-size: 28rpx;
  font-weight: 600;
}

.tools__desc {
  font-size: 22rpx;
  color: #98a2b3;
  margin-top: 4rpx;
}

.tools__arrow {
  font-size: 36rpx;
  color: #d0d5dd;
}

.footnote {
  margin: 36rpx 12rpx 0;
  font-size: 20rpx;
  color: #b0b7c3;
  line-height: 1.6;
  text-align: center;
}
