/* ---------- 核验说明渐变卡（对照 UI 设计稿：蓝色面板）---------- */
.verify-hero {
  background: linear-gradient(135deg, #2f8fe0 0%, #3aa0e8 45%, #4fb8e8 100%);
  border-radius: var(--r-lg);
  padding: 40rpx 34rpx;
  color: #fff;
  box-shadow: var(--sh-hero);
  margin-bottom: 24rpx;
}

.verify-hero__title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.45;
  letter-spacing: 1rpx;
  text-align: center;
}

.verify-hero__text {
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
  opacity: 0.92;
  text-align: center;
}

/* 吉祥物（放在问题下方，对照设计稿） */
.claim-mascot {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 0;
}

.claim-mascot .mascot--peek {
  width: 240rpx;
  height: 240rpx;
}

/* ---------- 步骤条 ---------- */
.steps {
  display: flex;
  align-items: center;
  padding: 26rpx 20rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 150rpx;
  flex: none;
}

.step__dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f4f7;
  color: var(--c-ink-3);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step__label {
  font-size: 20rpx;
  color: var(--c-ink-3);
  margin-top: 10rpx;
  text-align: center;
}

.step.is-on .step__dot {
  background: var(--c-primary);
  color: #fff;
}

.step.is-on .step__label { color: var(--c-primary-deep); font-weight: 600; }

.step.is-done .step__dot {
  background: var(--c-success);
  color: #fff;
}

.step.is-done .step__label { color: #067647; }

.step.is-fail .step__dot {
  background: var(--c-danger);
  color: #fff;
}

.step__bar {
  flex: 1;
  height: 4rpx;
  background: var(--c-line);
  margin: 0 -20rpx 26rpx;
}

.step__bar.is-on { background: var(--c-success); }

/* ---------- 物品对照 ---------- */
.pair {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pair__side {
  flex: 1;
  min-width: 0;
}

.pair__tag {
  display: inline-block;
  font-size: 19rpx;
  padding: 3rpx 12rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary-weak);
  color: var(--c-primary-deep);
  margin-bottom: 10rpx;
}

.pair__tag--found { background: #fff1e9; color: #c2410c; }

.pair__title {
  font-size: 27rpx;
  font-weight: 600;
}

.pair__meta {
  font-size: 21rpx;
  color: var(--c-ink-3);
  margin-top: 4rpx;
}

.pair__icon {
  font-size: 34rpx;
  color: #c7d3e8;
  flex: none;
}

/* ---------- 提示 ---------- */
.notice {
  background: linear-gradient(135deg, #f5f9ff, #eef4ff);
}

.notice__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-primary-deep);
}

.notice__text {
  font-size: 23rpx;
  color: #4763a8;
  line-height: 1.6;
  margin-top: 10rpx;
}

.safety {
  font-size: 24rpx;
  color: #b45309;
  background: #fff7e6;
  text-align: center;
}

/* ---------- 问题 ---------- */
.q {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.q__index {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: var(--c-primary);
  border-radius: var(--r-sm);
  padding: 2rpx 10rpx;
  margin: 6rpx 14rpx 0 0;
  flex: none;
}

.q__text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
}

/* ---------- 核验问答：快捷选项（互斥三选一）---------- */
.quick {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.quick__btn {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  padding: 16rpx 0;
  border-radius: var(--r-pill);
  background: #f2f4f7;
  color: #667085;
  border: 2rpx solid transparent;
}

/* 选中态必须足够显眼：这是「我点到了」的唯一回执 */
.quick__btn.is-on {
  background: var(--c-primary-weak);
  color: var(--c-primary-deep);
  border-color: var(--c-primary);
  font-weight: 700;
}

.quick-warn {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-sm);
  background: #fff7e6;
  border: 2rpx solid #fde3b0;
  font-size: 21rpx;
  color: #92400e;
  line-height: 1.6;
}

.hints {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.hint-chip {
  font-size: 21rpx;
  color: #667085;
  background: #f2f4f7;
  border-radius: var(--r-pill);
  padding: 8rpx 20rpx;
}

/* ---------- 结果 ---------- */
.result {
  text-align: center;
  padding: 40rpx 28rpx;
}

.result__score {
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1;
}

.result__score.is-good { color: var(--c-success); }
.result__score.is-mid { color: var(--c-warn); }
.result__score.is-bad { color: var(--c-danger); }

.result__pct { font-size: 30rpx; }

.result__label {
  font-size: 22rpx;
  color: var(--c-ink-3);
  margin-top: 8rpx;
}

.result__status {
  display: inline-block;
  margin-top: 18rpx;
}

.result__tip {
  font-size: 21rpx;
  color: var(--c-ink-3);
  line-height: 1.6;
  margin-top: 18rpx;
}

.ans {
  font-size: 26rpx;
  color: var(--c-ink);
  background: #f9fafb;
  border-radius: var(--r-sm);
  padding: 18rpx 20rpx;
  line-height: 1.6;
}

.ans__meta {
  display: flex;
  justify-content: space-between;
  font-size: 21rpx;
  color: #667085;
  margin-top: 12rpx;
}

.ans__reason { color: var(--c-ink-3); }

.priv {
  font-size: 24rpx;
  color: var(--c-ink-2);
  background: #f9fafb;
  border-radius: var(--r-sm);
  padding: 16rpx 20rpx;
  margin-top: 10rpx;
}

.op {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--c-primary);
}

/* ---------- 非双方访问提示 ---------- */
.outsider__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-ink);
}

.outsider__text {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--c-ink-2);
  line-height: 1.65;
}

.outsider__op {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--c-primary);
}

/* ---------- 核验期临时会话 ---------- */
.chat__state {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  background: #f2f4f7;
  color: var(--c-ink-2);
}

.chat__state--open { background: var(--c-success-weak); color: #067647; }
.chat__state--readonly { background: #f2f4f7; color: var(--c-ink-3); }

.chat__list {
  margin-top: 16rpx;
  max-height: 520rpx;
  background: #f9fafb;
  border-radius: var(--r-md);
  padding: 18rpx;
}

.chat__empty {
  font-size: 22rpx;
  color: var(--c-ink-3);
  line-height: 1.6;
  padding: 12rpx 4rpx;
}

/* 对方消息靠左、自己的靠右（对齐靠 margin，避免 flex 在 scroll-view 里的老问题） */
.chat__row {
  margin-bottom: 20rpx;
}

.chat__row.is-mine {
  text-align: right;
}

.chat__who {
  font-size: 19rpx;
  color: var(--c-ink-3);
  margin-bottom: 6rpx;
}

.chat__bubble {
  display: inline-block;
  max-width: 78%;
  text-align: left;
  font-size: 25rpx;
  line-height: 1.6;
  padding: 16rpx 20rpx;
  border-radius: var(--r-md);
  background: #fff;
  color: var(--c-ink);
  border: 2rpx solid var(--c-line);
  word-break: break-all;
}

.chat__row.is-mine .chat__bubble {
  background: var(--c-primary-weak);
  border-color: #bcd2fb;
  color: var(--c-primary-deep);
}

.chat__input {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.chat__field {
  background: #f9fafb;
  border: 2rpx solid #e4e7ec;
  border-radius: var(--r-pill);
  padding: 18rpx 24rpx;
  font-size: 25rpx;
}

.chat__send {
  flex: none;
  height: 72rpx;
  padding: 0 34rpx;
  line-height: 72rpx;
  border-radius: var(--r-pill);
  background: var(--g-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.chat__send.is-disabled {
  background: #d0d5dd;
  color: #fff;
}

.chat__closed {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--c-ink-3);
}

.chat__notice {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--c-ink-3);
  line-height: 1.6;
}
