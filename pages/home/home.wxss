.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 8rpx 28rpx;
}

.hero__logo {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  background: linear-gradient(135deg, var(--c-primary-deep), var(--c-primary) 60%, #4f9cf9);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero__slogan {
  font-size: 23rpx;
  color: var(--c-ink-3);
  margin-top: 6rpx;
}

.hero__bell {
  position: relative;
  font-size: 40rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(16, 24, 40, 0.08);
}

.hero__badge {
  position: absolute;
  top: -6rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--r-pill);
  background: var(--c-danger);
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

/* ---------- 主入口（对照 UI 设计稿）----------
   设计稿的两张卡是**上下错位重叠**的：绿色卡上边缘有一段弧形包边盖住紫色卡。
   这里用「负 margin 让两张卡贴合 + 绿色卡左上大圆角 + 轻微上移」近似这个层次。
   右侧/左侧放吉祥物素材。 */
.page--home {
  padding-top: 8rpx;
}

.entries {
  display: flex;
  flex-direction: column;
}

/* 紫色卡：我丢了东西 */
.entries__lost {
  background: var(--g-hero-lost);
  border-radius: var(--r-xl);
  padding: 30rpx 26rpx 30rpx 34rpx;
  min-height: 200rpx;
  position: relative;
  z-index: 1;
}

/* 绿色卡：我捡到东西 —— 上移贴合，左上大圆角形成"包边"效果 */
.entries__found {
  background: var(--g-hero-found);
  border-radius: var(--r-xl);
  border-top-left-radius: 96rpx;
  padding: 30rpx 34rpx 30rpx 26rpx;
  min-height: 200rpx;
  margin-top: -54rpx;
  position: relative;
  z-index: 2;
  box-shadow: var(--sh-hero-green);
}

/* 紫色卡的下半部分会被绿色卡盖住，这里保证文字不被遮挡 */
.entries__lost .hero-card__title,
.entries__lost .hero-card__sub {
  position: relative;
  z-index: 3;
}

/* ---------- 最近失物网格（对照设计稿：三张缩略图 + 状态角标）---------- */
.recent-grid {
  display: flex;
  gap: 18rpx;
}

.recent-grid__item {
  flex: 1;
  min-width: 0;
  position: relative;
}

.recent-grid__thumb {
  width: 100%;
  height: 190rpx;
  border-radius: var(--r-md);
  background: #f2f4f7;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(16, 24, 40, 0.08);
}

.recent-grid__thumb image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 状态角标压在缩略图左下角（设计稿的位置） */
.recent-grid__badge {
  position: absolute;
  left: 10rpx;
  bottom: 46rpx;
  font-size: 19rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 4rpx 10rpx rgba(16, 24, 40, 0.12);
}

.recent-grid__name {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--c-ink-2);
  text-align: center;
}

.recent-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--c-ink-3);
}

/* ---------- 地图横幅（对照设计稿）---------- */
.map-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(100deg, #eaf2ff 0%, #e6ecff 55%, #eee7ff 100%);
  box-shadow: var(--sh-card);
}

.map-banner__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-primary-deep);
}

.map-banner__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-ink-3);
}

.map-banner__arrow {
  font-size: 40rpx;
  color: var(--c-ink-3);
  flex: none;
}

/* ---------- 状态统计 ---------- */
.stats {
  margin-top: 28rpx;
  display: flex;
  padding: 26rpx 10rpx;
}

.stats__item {
  flex: 1;
  text-align: center;
}

.stats__num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--c-ink);
}

.stats__label {
  font-size: 21rpx;
  color: var(--c-ink-3);
  margin-top: 4rpx;
}

/* ---------- 持续寻找任务 ---------- */
.task {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.task + .task { margin-top: 18rpx; }

.task__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r-md);
  background: var(--c-primary-weak);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex: none;
}

.task__title {
  font-size: 30rpx;
  font-weight: 600;
}

.task__meta {
  font-size: 23rpx;
  color: var(--c-ink-3);
  margin-top: 6rpx;
}

.task__right {
  text-align: right;
  flex: none;
}

.task__count {
  font-size: 21rpx;
  color: var(--c-ink-3);
  margin-top: 8rpx;
}

/* ---------- 类别 ---------- */
.cats {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 8rpx 10rpx;
}

/* 每个类别是一个足够大的点击区域（≥112rpx 高），并带按下反馈，
   避免“点了没反应”的错觉 */
.cat {
  width: 25%;
  min-height: 132rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 18rpx 6rpx;
  border-radius: var(--r-md);
}

.cat--hover {
  background: var(--c-primary-weak);
  transform: scale(0.96);
}

.cat__icon {
  font-size: 46rpx;
  line-height: 1.2;
}

.cat__name {
  font-size: 21rpx;
  color: var(--c-ink-2);
  margin-top: 10rpx;
  line-height: 1.3;
}

/* ---------- 热力 ---------- */
.heat__row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.heat__name {
  width: 200rpx;
  font-size: 24rpx;
  color: var(--c-ink-2);
}

.heat__bar {
  flex: 1;
  height: 18rpx;
  background: #f2f4f7;
  border-radius: var(--r-pill);
  overflow: hidden;
  margin: 0 16rpx;
}

.heat__fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, #ffd6a8, #ff7a45);
  max-width: 100%;
}

.heat__val {
  width: 48rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
}

.heat__hint {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--c-ink-3);
}

/* ---------- 最新拾物 ---------- */
.recent {
  padding: 8rpx 24rpx;
}

.recent__item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f4f7;
}

.recent__item:last-child { border-bottom: none; }

.recent__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r-md);
  background: var(--g-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex: none;
}

.recent__title {
  font-size: 28rpx;
  font-weight: 600;
}

.recent__meta {
  font-size: 22rpx;
  color: var(--c-ink-3);
  margin-top: 4rpx;
}

.recent__tags {
  flex: none;
  max-width: 240rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.recent__tags .tag { margin: 0 0 6rpx 8rpx; }

/* ---------- 工具 ---------- */
.tools__item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}

.tools__icon { font-size: 40rpx; }

.tools__title {
  font-size: 28rpx;
  font-weight: 600;
}

.tools__desc {
  font-size: 22rpx;
  color: var(--c-ink-3);
  margin-top: 4rpx;
}

.tools__arrow {
  font-size: 36rpx;
  color: #d0d5dd;
}

.footnote {
  margin: 36rpx 12rpx 0;
  font-size: 20rpx;
  color: #b0b7c3;
  line-height: 1.6;
  text-align: center;
}
.quick-search { display: flex; align-items: center; padding: 24rpx; margin: 0 0 24rpx; background: rgba(255,255,255,.92); border-radius: 28rpx; }
.quick-search image { width: 66rpx; height: 66rpx; margin-right: 20rpx; }
.quick-search__title { color: #355d9d; font-size: 30rpx; font-weight: 600; }
.quick-search__sub { color: #7b8a9f; font-size: 23rpx; margin-top: 6rpx; }
.quick-search__arrow { margin-left: auto; font-size: 42rpx; color: #608ed1; }
