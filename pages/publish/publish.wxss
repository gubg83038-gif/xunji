.switcher {
  display: flex;
  background: #eef1f6;
  border-radius: var(--r-pill);
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.switcher__item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #667085;
  border-radius: var(--r-pill);
  font-weight: 600;
}

.switcher__item.is-active {
  background: #fff;
  color: var(--c-primary);
  box-shadow: 0 6rpx 16rpx rgba(16, 24, 40, 0.08);
}

/* ---------- 上传区（对照 UI 设计稿：整块青色渐变面板 + 相机图标）---------- */
.uploader {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(140deg, #d8f5f2 0%, #d6ecfb 45%, #e2e6fb 100%);
  border: 3rpx dashed rgba(79, 142, 247, 0.35);
  overflow: hidden;
}

/* 相机素材压在左上角（设计稿的位置） */
.uploader__icon {
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  width: 130rpx;
  height: 130rpx;
  opacity: 0.95;
}

.uploader__plus {
  font-size: 76rpx;
  font-weight: 200;
  color: rgba(79, 142, 247, 0.6);
  line-height: 1;
  margin-top: 24rpx;
}

.uploader__text {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #5b6b8c;
}

/* 右下角的点阵装饰（设计稿里的细节点缀） */
.uploader__dots {
  position: absolute;
  right: 26rpx;
  bottom: 22rpx;
  width: 96rpx;
  height: 60rpx;
  background-image: radial-gradient(rgba(79, 142, 247, 0.35) 3rpx, transparent 3rpx);
  background-size: 18rpx 18rpx;
}

.tipbar {
  background: rgba(255, 255, 255, 0.72);
  color: var(--c-primary-deep);
  font-size: 23rpx;
  border-radius: var(--r-md);
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.tipbar__link {
  color: var(--c-primary);
  text-decoration: underline;
  margin-left: 8rpx;
}

/* ---------- 图片 ---------- */
.image-add__cam {
  width: 48rpx;
  height: 48rpx;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-box {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--r-md);
  overflow: hidden;
  position: relative;
  background: #f2f4f7;
}

.image-box image {
  width: 100%;
  height: 100%;
}

.image-box__demo {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #eef4ff, #e2ecff);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
}

.image-box__icon { font-size: 40rpx; }

.image-box__label {
  font-size: 19rpx;
  color: #4763a8;
  text-align: center;
  margin-top: 6rpx;
  line-height: 1.3;
}

.image-box__del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(16, 24, 40, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--r-md);
  border: 2rpx dashed #c7d3e8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6b7fa8;
  background: #fbfcff;
}

.image-add__icon { font-size: 44rpx; }

.image-add__label {
  font-size: 21rpx;
  margin-top: 8rpx;
}

/* ---------- 地点 / 时间 ---------- */
.picker-value__arrow {
  color: var(--c-ink-3);
  font-size: 24rpx;
}

.location-input { margin-top: 14rpx; }

.time-row {
  display: flex;
  gap: 16rpx;
}

.picker-value--half {
  justify-content: center;
  min-width: 240rpx;
}

/* ---------- 属性 ---------- */
.attr {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f4f7;
}

.attr:last-of-type { border-bottom: none; }

.attr__key {
  width: 150rpx;
  flex: none;
  font-size: 25rpx;
  color: #667085;
}

.attr__val {
  font-size: 27rpx;
  color: var(--c-ink);
  padding: 10rpx 0;
}

.attr__input {
  background: #f9fafb;
  border-radius: var(--r-sm);
  padding: 14rpx 18rpx;
  font-size: 26rpx;
}

.attr__src {
  flex: none;
  font-size: 19rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--r-pill);
  background: #f2f4f7;
  color: #667085;
}

.attr__src.is-user {
  background: var(--c-primary-weak);
  color: var(--c-primary-deep);
}

.attr__op {
  flex: none;
  font-size: 24rpx;
  color: var(--c-primary);
  padding: 0 6rpx;
}

.attr__op--cancel { color: var(--c-ink-3); }

.attr__empty {
  font-size: 24rpx;
  color: var(--c-ink-3);
  padding: 20rpx 0;
}

/* ---------- 私有特征 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.chip {
  font-size: 23rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--r-pill);
  background: #f4f6fa;
  color: var(--c-ink-2);
  border: 2rpx solid transparent;
}

.chip.is-on {
  background: var(--c-primary-weak);
  color: var(--c-primary-deep);
  border-color: #bcd2fb;
  font-weight: 600;
}

.private-add {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 6rpx;
}
