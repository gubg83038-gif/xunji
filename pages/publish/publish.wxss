.switcher {
  display: flex;
  background: #eef1f6;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.switcher__item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #667085;
  border-radius: 999rpx;
  font-weight: 600;
}

.switcher__item.is-active {
  background: #fff;
  color: #2e6be6;
  box-shadow: 0 6rpx 16rpx rgba(16, 24, 40, 0.08);
}

.tipbar {
  background: #eaf1ff;
  color: #1b47a8;
  font-size: 23rpx;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.tipbar__link {
  color: #2e6be6;
  text-decoration: underline;
  margin-left: 8rpx;
}

/* ---------- 图片 ---------- */
.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-box {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background: #f2f4f7;
}

.image-box image {
  width: 100%;
  height: 100%;
}

.image-box__demo {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #eef4ff, #e2ecff);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
}

.image-box__icon { font-size: 40rpx; }

.image-box__label {
  font-size: 19rpx;
  color: #4763a8;
  text-align: center;
  margin-top: 6rpx;
  line-height: 1.3;
}

.image-box__del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(16, 24, 40, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #c7d3e8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6b7fa8;
  background: #fbfcff;
}

.image-add__icon { font-size: 44rpx; }

.image-add__label {
  font-size: 21rpx;
  margin-top: 8rpx;
}

/* ---------- 地点 / 时间 ---------- */
.picker-value__arrow {
  color: #98a2b3;
  font-size: 24rpx;
}

.location-input { margin-top: 14rpx; }

.time-row {
  display: flex;
  gap: 16rpx;
}

.picker-value--half {
  justify-content: center;
  min-width: 240rpx;
}

/* ---------- 属性 ---------- */
.attr {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f4f7;
}

.attr:last-of-type { border-bottom: none; }

.attr__key {
  width: 150rpx;
  flex: none;
  font-size: 25rpx;
  color: #667085;
}

.attr__val {
  font-size: 27rpx;
  color: #101828;
  padding: 10rpx 0;
}

.attr__input {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
}

.attr__src {
  flex: none;
  font-size: 19rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  color: #667085;
}

.attr__src.is-user {
  background: #eaf1ff;
  color: #1b47a8;
}

.attr__op {
  flex: none;
  font-size: 24rpx;
  color: #2e6be6;
  padding: 0 6rpx;
}

.attr__op--cancel { color: #98a2b3; }

.attr__empty {
  font-size: 24rpx;
  color: #98a2b3;
  padding: 20rpx 0;
}

/* ---------- 私有特征 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.chip {
  font-size: 23rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f4f6fa;
  color: #475467;
  border: 2rpx solid transparent;
}

.chip.is-on {
  background: #eaf1ff;
  color: #1b47a8;
  border-color: #bcd2fb;
  font-weight: 600;
}

.private-add {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 6rpx;
}
