.switcher {
  display: flex;
  background: #eef1f6;
  border-radius: var(--r-pill);
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.switcher__item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #667085;
  border-radius: var(--r-pill);
  font-weight: 600;
}

.switcher__item.is-active {
  background: #fff;
  color: var(--c-primary);
  box-shadow: 0 6rpx 16rpx rgba(16, 24, 40, 0.08);
}

/* ---------- 上传区（对照 UI 设计稿：整块青色渐变面板 + 相机图标）---------- */
.uploader {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(140deg, #d8f5f2 0%, #d6ecfb 45%, #e2e6fb 100%);
  border: 3rpx dashed rgba(79, 142, 247, 0.35);
  overflow: hidden;
}

/* 相机素材压在左上角（设计稿的位置） */
.uploader__icon {
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  width: 130rpx;
  height: 130rpx;
  opacity: 0.95;
}

.uploader__plus {
  font-size: 76rpx;
  font-weight: 200;
  color: rgba(79, 142, 247, 0.6);
  line-height: 1;
  margin-top: 24rpx;
}

.uploader__text {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #5b6b8c;
}

/* 右下角的点阵装饰（设计稿里的细节点缀） */
.uploader__dots {
  position: absolute;
  right: 26rpx;
  bottom: 22rpx;
  width: 96rpx;
  height: 60rpx;
  background-image: radial-gradient(rgba(79, 142, 247, 0.35) 3rpx, transparent 3rpx);
  background-size: 18rpx 18rpx;
}

.tipbar {
  background: rgba(255, 255, 255, 0.72);
  color: var(--c-primary-deep);
  font-size: 23rpx;
  border-radius: var(--r-md);
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.tipbar__link {
  color: var(--c-primary);
  text-decoration: underline;
  margin-left: 8rpx;
}

/* ---------- 图片 ---------- */
.image-add__cam {
  width: 48rpx;
  height: 48rpx;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-box {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--r-md);
  overflow: hidden;
  position: relative;
  background: #f2f4f7;
}

.image-box image {
  width: 100%;
  height: 100%;
}

.image-box__demo {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #eef4ff, #e2ecff);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
}

.image-box__icon { font-size: 40rpx; }

.image-box__label {
  font-size: 19rpx;
  color: #4763a8;
  text-align: center;
  margin-top: 6rpx;
  line-height: 1.3;
}

.image-box__del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(16, 24, 40, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--r-md);
  border: 2rpx dashed #c7d3e8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6b7fa8;
  background: #fbfcff;
}

.image-add__icon { font-size: 44rpx; }

.image-add__label {
  font-size: 21rpx;
  margin-top: 8rpx;
}

/* ---------- 地点 / 时间 ---------- */
.picker-value__arrow {
  color: var(--c-ink-3);
  font-size: 24rpx;
}

/**
 * 选择器下方的「自定义输入」区块。
 * ------------------------------------------------------------------
 * 用户反馈：手动输入时间/地点时，输入框会和上方的选择器边框粘在一起，
 * 看起来像叠成了同一个输入框。
 * 这里做三件事把两块彻底分开：
 *   1. 顶部留 22rpx + 一条实线分隔，明确是两个独立控件；
 *   2. 加一行说明文字，用户不会以为还是同一个框；
 *   3. 输入框自带 2rpx 浅边框与白底，与选择器的浅灰底形成区分。
 */
.subfield {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--c-line);
}

.subfield__label {
  font-size: 21rpx;
  color: var(--c-ink-3);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.subfield__input {
  background: #fff;
  border: 2rpx solid #e4e7ec;
}

.time-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

/* 选择器在 flex 行里必须能伸展，否则窄屏下与下方输入框错位 */
.time-row__picker { flex: 1; min-width: 0; }

.picker-value--half {
  justify-content: center;
  width: 100%;
}

/* ---------- 属性 ---------- */
.attr {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f4f7;
}

.attr:last-of-type { border-bottom: none; }

.attr__key {
  width: 150rpx;
  flex: none;
  font-size: 25rpx;
  color: #667085;
}

.attr__val {
  font-size: 27rpx;
  color: var(--c-ink);
  padding: 10rpx 0;
}

/* 空值占位：提示「可以点这里补」，而不是看起来像已经填好了 */
.attr__val--empty {
  color: var(--c-ink-3);
  font-size: 24rpx;
}

.attr__input {
  background: #f9fafb;
  border-radius: var(--r-sm);
  padding: 14rpx 18rpx;
  font-size: 26rpx;
}

.attr__src {
  flex: none;
  font-size: 19rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--r-pill);
  background: #f2f4f7;
  color: #667085;
}

.attr__src.is-user {
  background: var(--c-primary-weak);
  color: var(--c-primary-deep);
}

.attr__op {
  flex: none;
  font-size: 24rpx;
  color: var(--c-primary);
  padding: 0 6rpx;
}

.attr__op--cancel { color: var(--c-ink-3); }

.attr__empty {
  font-size: 24rpx;
  color: var(--c-ink-3);
  padding: 20rpx 0;
}

/* ---------- 私有特征 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.chip {
  font-size: 23rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--r-pill);
  background: #f4f6fa;
  color: var(--c-ink-2);
  border: 2rpx solid transparent;
}

.chip.is-on {
  background: var(--c-primary-weak);
  color: var(--c-primary-deep);
  border-color: #bcd2fb;
  font-weight: 600;
}

/* ---------- 已选特征清单（每条都能撤回）---------- */
.plist__title {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--c-ink-2);
  margin: 6rpx 0 12rpx;
}

.plist__cap {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--c-ink-3);
}

.plist {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.plist__item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f9fafb;
  border: 2rpx solid var(--c-line);
  border-radius: var(--r-sm);
  padding: 16rpx 18rpx;
}

.plist__no {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--c-primary-weak);
  color: var(--c-primary-deep);
  font-size: 20rpx;
  font-weight: 700;
}

.plist__text {
  font-size: 24rpx;
  color: var(--c-ink);
  word-break: break-all;
}

/* 删除按钮做成 56rpx 的方形热区，避免误触相邻项 */
.plist__del {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #e4e7ec;
  color: var(--c-ink-3);
  font-size: 32rpx;
}

.plist__undo {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--c-primary);
  text-decoration: underline;
}

.private-add {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 18rpx;
}

/* ---------- AI 识别遮罩 ---------- */
.ai-mask {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(35, 75, 145, 0.28);
  backdrop-filter: blur(8rpx);
}

.ai-panel {
  width: 520rpx;
  min-height: 430rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 28rpx 40rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24rpx 70rpx rgba(28, 61, 125, 0.25);
}

.ai-panel__video,
.ai-panel__mascot {
  width: 300rpx;
  height: 260rpx;
}

.ai-panel__mascot {
  animation: ai-float 1.8s ease-in-out infinite;
}

.ai-panel__title {
  margin-top: 18rpx;
  color: var(--c-primary-deep);
  font-size: 29rpx;
  font-weight: 600;
  text-align: center;
}

.ai-panel__dots {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  color: var(--c-primary);
  font-size: 34rpx;
  line-height: 1;
}

.ai-panel__dots text {
  animation: ai-dot 1.2s ease-in-out infinite;
}

.ai-panel__dots text:nth-child(2) { animation-delay: 0.16s; }
.ai-panel__dots text:nth-child(3) { animation-delay: 0.32s; }

@keyframes ai-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

@keyframes ai-dot {
  0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-6rpx); }
}
