/* ============================================================
   「寻迹」全局设计系统
   视觉语言：物品卡片 + 匹配证据 + 地图 + 时间线 + 状态反馈

   风格基调（对照 UI 设计稿）：
     浅蓝 → 淡紫的渐变背景、大圆角白卡、胶囊按钮、
     彩色药丸标签、柔和阴影、大量留白。
   ============================================================ */
page {
  --c-primary: #2e6be6;
  --c-primary-weak: #eaf1ff;
  --c-primary-deep: #1b47a8;
  --c-accent: #ff7a45;
  --c-accent-weak: #fff1e9;
  --c-success: #12b76a;
  --c-success-weak: #e7f8f0;
  --c-warn: #f59e0b;
  --c-warn-weak: #fff7e6;
  --c-danger: #f04438;
  --c-danger-weak: #feeceb;
  --c-ink: #101828;
  --c-ink-2: #475467;
  --c-ink-3: #98a2b3;
  --c-line: #eaecf0;
  --c-bg: #f6f7fb;
  --c-card: #ffffff;

  /* ---- 设计稿新增：渐变与装饰色 ---- */
  /**
   * 页面背景渐变。
   * 取自设计稿的「背景.png」：顶部青绿 → 中段天蓝 → 底部淡紫。
   * 比初版更亮更饱和，这是设计稿的主要视觉基调。
   */
  --g-page: linear-gradient(180deg, #9fe8e0 0%, #8fd8f5 22%, #a8c9f5 52%, #c3b6ef 78%, #d9c8f2 100%);
  /** 首页两张入口大卡（设计稿：丢失=紫，捡到=绿） */
  --g-hero-lost: linear-gradient(100deg, #8b7bf0 0%, #6f8de8 42%, #7fc9e8 100%);
  --g-hero-found: linear-gradient(100deg, #6fd8b0 0%, #7fe0c8 45%, #9ae8d8 100%);
  --g-hero-blue: var(--g-hero-lost);
  --g-hero-green: var(--g-hero-found);
  /** 主按钮（设计稿是紫蓝渐变胶囊） */
  --g-primary: linear-gradient(100deg, #7b7cf0 0%, #4f8ef7 100%);
  /** 匹配度强调色（设计稿里的大号百分比） */
  --g-score: linear-gradient(135deg, #2e6be6, #7b5cf0);
  /** 轻量渐变面（图标底、徽标底） */
  --g-soft: linear-gradient(135deg, #eef4ff, #f3edff);
  /** 匹配度椭圆底色（设计稿里 92% 外面那圈椭圆） */
  --g-ellipse: linear-gradient(150deg, #dbe6ff 0%, #cdd8fb 55%, #e2d9f8 100%);

  /* ---- 设计稿新增：阴影 ---- */
  --sh-card: 0 10rpx 32rpx rgba(46, 107, 230, 0.10);
  --sh-hero: 0 16rpx 36rpx rgba(123, 124, 240, 0.26);
  --sh-hero-green: 0 16rpx 36rpx rgba(111, 216, 176, 0.30);
  --sh-btn: 0 12rpx 28rpx rgba(79, 142, 247, 0.30);

  /* ---- 圆角整体放大（设计稿卡片更圆润）---- */
  --r-sm: 16rpx;
  --r-md: 24rpx;
  --r-lg: 36rpx;
  --r-xl: 48rpx;
  --r-pill: 999rpx;

  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 48rpx;

  background: var(--c-bg);
  color: var(--c-ink);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  line-height: 1.5;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
/**
 * 页面容器带渐变背景。
 * 用 min-height 而不是固定高度，保证内容超长时渐变自然延伸。
 */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--g-page);
}

.page--flush {
  padding: 0 0 calc(48rpx + env(safe-area-inset-bottom));
}

/**
 * 不要渐变背景的页面（例如地图页：整屏是地图，渐变会露出缝隙）。
 * 用 transparent 而不是覆盖成纯色，便于页面自己控制。
 */
.page--plain {
  background: transparent;
}

.page-header {
  padding: 16rpx 8rpx 24rpx;
}

.page-title {
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.page-subtitle {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--c-ink-3);
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 6rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-more {
  font-size: 25rpx;
  color: var(--c-primary);
}

.row {
  display: flex;
  align-items: center;
}

.row--between {
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

/* ---------- 卡片（设计稿：更圆、更大留白、柔和投影）---------- */
.card {
  background: var(--c-card);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow: var(--sh-card);
}

.card + .card {
  margin-top: 24rpx;
}

.card--flat {
  box-shadow: none;
  border: 2rpx solid var(--c-line);
}

/* ---------- 首页入口大卡（设计稿的两张彩色卡）---------- */
.hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 190rpx;
  padding: 36rpx 34rpx;
  border-radius: var(--r-xl);
  color: #fff;
  box-shadow: var(--sh-hero);
}

.hero-card--green {
  box-shadow: var(--sh-hero-green);
}

.hero-card__title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-card__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.hero-card__emoji {
  font-size: 84rpx;
  line-height: 1;
  opacity: 0.95;
}

/* ---------- 文字 ---------- */
.t { font-size: 28rpx; color: var(--c-ink); }
.t-sm { font-size: 24rpx; color: var(--c-ink-2); }
.t-xs { font-size: 22rpx; color: var(--c-ink-3); }
.t-lg { font-size: 34rpx; font-weight: 600; }
.t-muted { color: var(--c-ink-3); }
.t-primary { color: var(--c-primary); }
.t-danger { color: var(--c-danger); }
.t-success { color: var(--c-success); }
.bold { font-weight: 600; }
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---------- 标签（设计稿：更饱满的彩色药丸）---------- */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: var(--r-pill);
  font-size: 23rpx;
  font-weight: 500;
  background: var(--c-primary-weak);
  color: var(--c-primary-deep);
}

.tag--gray { background: #f2f4f7; color: var(--c-ink-2); }
.tag--accent { background: var(--c-accent-weak); color: #c2410c; }
.tag--success { background: var(--c-success-weak); color: #067647; }
.tag--warn { background: var(--c-warn-weak); color: #b45309; }
.tag--danger { background: var(--c-danger-weak); color: #b42318; }
.tag--ghost {
  background: transparent;
  border: 2rpx solid var(--c-line);
  color: var(--c-ink-2);
}
/* 设计稿里的金属/材质类标签：浅紫底 */
.tag--violet { background: #f2ecff; color: #6941c6; }
/* 设计稿里的描述类标签：浅青底 */
.tag--cyan { background: #e4f6fb; color: #0d7d9c; }

/* ---------- 按钮（设计稿：胶囊形 + 渐变 + 投影）---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: var(--r-pill);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}

.btn::after { border: none; }

.btn--primary {
  background: var(--g-primary);
  color: #fff;
  box-shadow: var(--sh-btn);
}

.btn--ghost {
  background: #fff;
  color: var(--c-primary);
  border: 2rpx solid rgba(46, 107, 230, 0.4);
}

.btn--plain {
  background: #f2f4f7;
  color: var(--c-ink-2);
}

.btn--danger {
  background: var(--c-danger-weak);
  color: var(--c-danger);
}

.btn--sm {
  height: 68rpx;
  font-size: 25rpx;
  padding: 0 30rpx;
  border-radius: var(--r-pill);
}

.btn--block { width: 100%; }

.btn[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

/* ---------- 大号匹配度（设计稿：椭圆底 + 醒目的百分比）---------- */
.score-big {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: var(--c-primary);
}

/**
 * 设计稿里的匹配度是放在一个浅蓝紫椭圆里的。
 * 用椭圆容器包住数字，比纯文字更醒目，也更贴合设计稿。
 */
.score-ellipse {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 14rpx 30rpx;
  border-radius: 50%;
  background: var(--g-ellipse);
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 4rpx 12rpx rgba(255, 255, 255, 0.75),
              0 6rpx 16rpx rgba(79, 142, 247, 0.16);
}

.score-big__num {
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1;
  background: var(--g-score);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.score-big__pct {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-primary);
}

.score-big__label {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--c-ink-3);
}

/* ---------- 吉祥物（设计稿素材，放在卡片装饰位）---------- */
.mascot {
  flex: none;
  display: block;
}

.mascot--hero {
  width: 190rpx;
  height: 190rpx;
}

.mascot--peek {
  width: 220rpx;
  height: 220rpx;
}

.mascot--empty {
  width: 200rpx;
  height: 200rpx;
}

/* ---------- 3D 图标（设计稿素材）---------- */
.ui-icon {
  display: block;
  flex: none;
}

.ui-icon--lg { width: 96rpx; height: 96rpx; }
.ui-icon--md { width: 72rpx; height: 72rpx; }
.ui-icon--sm { width: 52rpx; height: 52rpx; }

/* ---------- 表单 ---------- */
.form-item {
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.form-item:last-child { border-bottom: none; }

.form-label {
  font-size: 26rpx;
  color: var(--c-ink-2);
  font-weight: 600;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
}

.form-label .req { color: var(--c-danger); margin-left: 6rpx; }

.form-hint {
  font-size: 22rpx;
  color: var(--c-ink-3);
  margin-top: 10rpx;
}

.input,
.textarea {
  width: 100%;
  font-size: 29rpx;
  color: var(--c-ink);
  background: #f9fafb;
  border-radius: var(--r-sm);
  padding: 20rpx 22rpx;
}

.textarea { min-height: 170rpx; line-height: 1.55; }

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f9fafb;
  border-radius: var(--r-sm);
  padding: 20rpx 22rpx;
  font-size: 29rpx;
}

.picker-value.is-empty { color: var(--c-ink-3); }

/* ---------- AI 建议标识 ---------- */
.ai-badge {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: linear-gradient(135deg, #eef2ff, #e0f2fe);
  color: #3538cd;
  border: 2rpx solid #dbe4ff;
}

/* ---------- 状态 ---------- */
.status {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status--searching { background: var(--c-primary-weak); color: var(--c-primary-deep); }
.status--candidate { background: var(--c-warn-weak); color: #b45309; }
.status--verifying { background: #f4ebff; color: #6941c6; }
.status--handover { background: #e0f2fe; color: #026aa2; }
.status--recovered { background: var(--c-success-weak); color: #067647; }
.status--closed { background: #f2f4f7; color: var(--c-ink-3); }
.status--available { background: var(--c-primary-weak); color: var(--c-primary-deep); }
.status--reserved { background: var(--c-warn-weak); color: #b45309; }
.status--returned { background: var(--c-success-weak); color: #067647; }
.status--failed { background: var(--c-danger-weak); color: #b42318; }

/* ---------- 分割线 / 空状态容器 ---------- */
.divider {
  height: 2rpx;
  background: var(--c-line);
  margin: 24rpx 0;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid var(--c-line);
  display: flex;
  gap: 18rpx;
  z-index: 20;
}

.footer-placeholder { height: 160rpx; }

/* ---------- 缩略图 ---------- */
.thumb {
  border-radius: var(--r-md);
  background: #f2f4f7;
  overflow: hidden;
  position: relative;
}

.thumb image { width: 100%; height: 100%; display: block; }

.thumb__fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: linear-gradient(135deg, #eef4ff, #e7f0ff);
  color: #93b4f5;
}
