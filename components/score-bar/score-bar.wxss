.sb__row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.sb__row:last-child { margin-bottom: 0; }

.sb__label {
  width: 168rpx;
  flex: none;
  font-size: 24rpx;
  color: var(--c-ink-2);
  display: flex;
  flex-direction: column;
}

.sb__weight {
  font-size: 18rpx;
  color: var(--c-ink-3);
}

.sb__track {
  flex: 1;
  height: 16rpx;
  border-radius: var(--r-pill);
  background: #f2f4f7;
  overflow: hidden;
  margin: 0 16rpx;
}

.sb__fill {
  height: 100%;
  border-radius: var(--r-pill);
  transition: width 0.35s ease;
}

.sb__fill.is-high { background: linear-gradient(90deg, #4ade80, var(--c-success)); }
.sb__fill.is-mid { background: linear-gradient(90deg, #7aa4f5, var(--c-primary)); }
.sb__fill.is-low { background: linear-gradient(90deg, #fbbf24, var(--c-warn)); }
.sb__fill.is-off {
  background: repeating-linear-gradient(45deg, var(--c-line), var(--c-line) 8rpx, #f6f7fb 8rpx, #f6f7fb 16rpx);
}

.sb__value {
  width: 92rpx;
  flex: none;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-ink);
}

.sb__na {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--c-ink-3);
}
