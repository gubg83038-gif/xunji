<!--
  候选匹配卡片（对照 UI 设计稿）
  布局：左侧物品缩略图 + 下方来源用户 ｜ 右侧大号匹配度 + 查看详情按钮
  下方保留时空信息、标签与可解释证据（这是本项目的核心卖点，不能为美观牺牲）
-->
<view class="mc" wx:if="{{match}}" bindtap="onTap">
  <view class="mc__rank" wx:if="{{rank}}">TOP {{rank}}</view>

  <view class="mc__main">
    <!-- 左：缩略图 -->
    <view class="mc__left">
      <view class="mc__thumb thumb">
        <!-- hasImage 由视图模型预计算：demo:// 是演示图库标识，不能当图片资源渲染 -->
        <image
          wx:if="{{match.counterpart.hasImage && !imageError}}"
          src="{{match.counterpart.image}}"
          mode="aspectFill"
          binderror="onImageError"
        />
        <view wx:else class="thumb__fallback">{{match.counterpart.icon}}</view>
        <view class="mc__thumb-tag">{{match.counterpart.typeLabel}}</view>
      </view>
      <view class="mc__from ellipsis">{{match.counterpart.ownerName || '匿名同学'}} 发布</view>
    </view>

    <!-- 右：匹配度 + 详情（对照设计稿：百分比放在浅蓝紫椭圆里） -->
    <view class="mc__right">
      <view class="mc__score-label">综合匹配度</view>
      <view class="score-ellipse mc__score {{match.passed ? 'is-high' : ''}}">
        <text class="score-big__num">{{match.percent}}</text>
        <text class="score-big__pct">%</text>
      </view>
      <view class="btn btn--sm btn--primary mc__detail-btn" catchtap="onTap">查看详情</view>
    </view>
  </view>

  <view class="mc__info">
    <view class="mc__title ellipsis">{{match.counterpart.title}}</view>
    <view class="mc__meta-line">
      <text class="mc__meta-icon">📍</text>
      <text class="ellipsis">{{match.counterpart.locationName}}</text>
      <text class="mc__meta-sep">·</text>
      <text>{{match.geoText}}</text>
    </view>
    <view class="mc__meta-line">
      <text class="mc__meta-icon">🕒</text>
      <text>{{match.counterpart.timeText}}</text>
      <text class="mc__meta-sep">·</text>
      <text>{{match.timeText}}</text>
    </view>
  </view>

  <view class="mc__tags">
    <text wx:for="{{match.counterpart.tags}}" wx:key="*this" class="tag">{{item}}</text>
  </view>

  <view class="mc__reasons" wx:if="{{match.reasonTexts.length}}">
    <view class="mc__reason" wx:for="{{match.reasonTexts}}" wx:key="text">
      <text class="mc__reason-dot"></text>
      <text class="grow">{{item}}</text>
    </view>
  </view>

  <view class="mc__conflict" wx:if="{{match.conflictTexts.length}}">
    <text class="mc__conflict-title">⚠ 显著差异</text>
    <text class="mc__conflict-item" wx:for="{{match.conflictTexts}}" wx:key="text">{{item}}</text>
  </view>

  <view class="mc__uncertain" wx:if="{{expanded && match.uncertainTexts.length}}">
    <text class="mc__uncertain-title">? 不确定证据</text>
    <text class="mc__uncertain-item" wx:for="{{match.uncertainTexts}}" wx:key="text">{{item}}</text>
  </view>

  <view class="mc__foot">
    <view class="mc__more" catchtap="onToggleReason">{{expanded ? '收起' : '更多依据'}}</view>
    <view class="mc__actions">
      <!--
        已排除的候选：显示醒目标记 + 「撤销排除」，而不是继续摆一个「排除」按钮。
        用户反馈「点了排除界面没有任何变化」，本质是缺少这个状态标记。
      -->
      <block wx:if="{{match.status === 'rejected'}}">
        <view class="mc__rejected-tag">🚫 已排除</view>
        <view class="btn btn--sm btn--ghost" catchtap="onRestore">撤销排除</view>
      </block>
      <block wx:else>
        <view wx:if="{{showReject}}" class="btn btn--sm btn--plain" catchtap="onReject">排除</view>
        <view class="btn btn--sm btn--primary" catchtap="onClaim">发起认领</view>
      </block>
    </view>
  </view>
</view>
