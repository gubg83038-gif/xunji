.mc {
  position: relative;
  background: #fff;
  border-radius: var(--r-lg, 36rpx);
  padding: 30rpx;
  box-shadow: var(--sh-card, 0 10rpx 32rpx rgba(46, 107, 230, 0.08));
  overflow: hidden;
}

/* 左侧渐变竖条（保留原有的视觉锚点，颜色对齐新主色） */
.mc::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #9dc0ff, var(--c-primary));
}

.mc__rank {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #7aa4f5, var(--c-primary));
  border-radius: var(--r-pill, 999rpx);
  padding: 4rpx 16rpx;
  margin-bottom: 16rpx;
}

/* ---------- 主区：左图 ｜ 右匹配度（对照设计稿）---------- */
.mc__main {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.mc__left {
  flex: none;
  width: 200rpx;
}

.mc__thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-md, 24rpx);
}

.mc__from {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--c-ink-3);
  text-align: center;
}

.mc__right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  padding-top: 8rpx;
}

.mc__score-label {
  font-size: 22rpx;
  color: var(--c-ink-3);
  margin-bottom: 4rpx;
}

.mc__score {
  /* 大号百分比样式来自 app.wxss 的 .score-big */
  margin-bottom: 18rpx;
}

/* 超过阈值时用绿色强调（设计稿里高匹配度是绿色/蓝色渐变） */
.mc__score.is-high .score-big__num {
  background: linear-gradient(135deg, var(--c-success), #3ecfa0);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.mc__score.is-high .score-big__pct { color: var(--c-success); }

.mc__detail-btn {
  min-width: 176rpx;
}

/* ---------- 信息区 ---------- */
.mc__info {
  margin-top: 24rpx;
}

.mc__title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.mc__meta-line {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-ink-2);
  margin-bottom: 6rpx;
  min-width: 0;
}

.mc__meta-icon {
  margin-right: 8rpx;
  font-size: 22rpx;
  flex: none;
}

.mc__meta-sep {
  margin: 0 8rpx;
  color: #d0d5dd;
  flex: none;
}

.mc__tags {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
}

.mc__tags .tag {
  margin-bottom: 8rpx;
}

.mc__thumb-tag {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--r-pill, 999rpx);
  background: rgba(16, 24, 40, 0.62);
  color: #fff;
}

.mc__reasons {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--c-line);
}

.mc__reason {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  color: #067647;
  margin-bottom: 8rpx;
}

.mc__reason-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--c-success);
  margin: 12rpx 12rpx 0 0;
  flex: none;
}

.mc__conflict {
  margin-top: 12rpx;
  background: #fff7e6;
  border-radius: var(--r-sm, 16rpx);
  padding: 18rpx 22rpx;
  display: flex;
  flex-direction: column;
}

.mc__conflict-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #b45309;
  margin-bottom: 6rpx;
}

.mc__conflict-item {
  font-size: 22rpx;
  color: #92400e;
}

.mc__uncertain {
  margin-top: 12rpx;
  background: #f9fafb;
  border-radius: var(--r-sm, 16rpx);
  padding: 18rpx 22rpx;
  display: flex;
  flex-direction: column;
}

.mc__uncertain-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--c-ink-2);
  margin-bottom: 6rpx;
}

.mc__uncertain-item {
  font-size: 22rpx;
  color: #667085;
}

.mc__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.mc__more {
  font-size: 23rpx;
  color: var(--c-primary);
}

.mc__actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 「已排除」标记：排除后必须有明确的状态回执，否则用户以为没生效 */
.mc__rejected-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #b42318;
  background: var(--c-danger-weak, #feeceb);
  border-radius: var(--r-pill, 999rpx);
  padding: 8rpx 20rpx;
}

/* 已排除的卡片整体降饱和，与正常候选拉开对比 */
.mc__rejected-tag ~ .btn { opacity: 0.9; }
